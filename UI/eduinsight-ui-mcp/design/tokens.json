  "semantic": {
    "primary": { "bg": "#2B59FF", "fg": "#FFFFFF", "note": "nút chính, mục nav đang chọn, đường dữ liệu chính" },
    "accent": { "bg": "#FFD23F", "fg": "#111111", "note": "khối hero, trạng thái được chọn, đầu bảng" },
    "positive": { "bg": "#3DDC97", "fg": "#111111", "text": "#0A7A4B", "note": "tiến bộ, hợp lệ" },
    "negative": { "bg": "#FF5A36", "fg": "#111111", "text": "#C2290F", "note": "sa sút, lỗi, dưới ngưỡng" },
    "warning": { "bg": "#FFE9A8", "fg": "#111111", "text": "#B54708", "note": "cảnh báo, cần xem lại" },
    "info": { "bg": "#B8A4FF", "fg": "#111111", "note": "nhóm cần xem lại, thông tin phụ" },
    "neutral": { "bg": "#F6EFD9", "fg": "#3A3528", "note": "ổn định, thiếu dữ liệu" },
