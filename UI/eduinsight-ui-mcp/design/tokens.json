  "shadow": {
    "sticker": "5px 5px 0 #111111",
    "button": "3px 3px 0 #111111",
    "selected": "4px 4px 0 #111111",
    "none": "none"
  },
  "space": { "pageX": "32px", "pageXMobile": "16px", "sectionGap": "28px", "gridGap": "24px", "cardPadding": "24px", "cardPaddingSm": "18px" },
  "layout": { "maxWidth": "1400px", "touchTarget": "44px", "background": "background-color:#FFF4D6; background-image: radial-gradient(#E8D9AE 1.2px, transparent 1.2px); background-size: 22px 22px" },
  "motion": { "hover": "translate(-1px,-1px) + shadow 3px", "press": "translate(2px,2px) + shadow none", "duration": "120ms" },
  "rotation": { "stickerTilt": [-1.5, 1.2, 1, -1.2], "logo": -2.5, "tag": -2, "note": "Chỉ nghiêng thẻ số liệu, logo, nhãn nổi bật. Không nghiêng bảng, biểu đồ, form." }
